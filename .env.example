# Get your key at https://kie.ai/api-key
# Optional: the desktop app can also store the key from its in-app Settings
# screen (persisted in SQLite under the app's user-data dir). The stored key
# takes precedence over this env var.
KIE_API_KEY=your_api_key_here

# Optional
PORT=8787

# Optional: override the SQLite location. The desktop app sets this to a
# writable user-data path automatically; dev falls back to data/studio.db.
# STUDIO_DB_PATH=

# Optional: static host base URL for Electrobun differential auto-updates.
# Leave empty to disable updates (local builds).
# RELEASE_BASE_URL=

# Optional: xAI Grok API key for agent mode.
# Also used by Grok CLI / prompt optimization when not already `grok login`.
# https://docs.x.ai
# XAI_API_KEY=xai-...

# Catalog sync on server start (default: on, skip if < 12h old)
# SYNC_MODELS_ON_START=0
# SYNC_MODELS_FORCE=1
# SYNC_CONCURRENCY=12

# --- LAN access (added by Lily) ---
# Set to 1 to expose the Vite dev server on 0.0.0.0 (accessible from other
# machines on the LAN / Tailscale). Also requires STUDIO_API_HOST below.
# STUDIO_LAN=1
# Bind the Hono API to all interfaces (default 127.0.0.1).
# STUDIO_API_HOST=0.0.0.0
# Extra CORS origins allowed to call the API, comma-separated. Must match the
# origin you use in the browser, e.g. http://<this-machine-IP>:5173
# STUDIO_CORS_ORIGINS=
